import streamlit as st
import random

# List of words
words = ["python", "streamlit", "guessing", "name", "age"]

# Initialize session state
if "selected_word" not in st.session_state:
    st.session_state.selected_word = random.choice(words)
    st.session_state.attempts = []
    st.session_state.game_over = False

# Title
st.title("🎮 Word Guessing Game")
st.write("Guess the word one letter at a time!")

# Display word
display_word = " ".join(
    [
        letter if letter in st.session_state.attempts else "_"
        for letter in st.session_state.selected_word
    ]
)

st.write("###", display_word)

# Input
guess = st.text_input("Enter a letter:", max_chars=1)

# Submit button
if st.button("Submit Guess"):

    if len(guess) == 1 and guess.isalpha():

        if guess not in st.session_state.attempts:

            st.session_state.attempts.append(guess.lower())

            if all(
                letter in st.session_state.attempts
                for letter in st.session_state.selected_word
            ):
                st.session_state.game_over = True
                st.success(
                    f"🎉 Congratulations! You guessed the word: {st.session_state.selected_word}"
                )

        else:
            st.warning("⚠️ You've already guessed that letter!")

    else:
        st.warning("⚠️ Please enter a single letter.")

# Show guessed letters
st.write("Guessed Letters:", ", ".join(st.session_state.attempts))

# Restart game
if st.session_state.game_over:

    if st.button("Play Again"):

        st.session_state.selected_word = random.choice(words)
        st.session_state.attempts = []
        st.session_state.game_over = False

        st.rerun()
